# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# dev server runtime artifacts（npm run dev 產生）
/dev.log
/dev.pid

# supabase types generation leftover
/src/lib/*.ts.new

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.mcp.json
~$*

# raw scraped image dumps (reference only; use public/bikes/ for app assets)
/material/images/
# user-captured screenshots sitting at repo root
/CleanShot *.png
# debug / playwright snapshot screenshots at repo root
/*-result.png
/*-screenshot.png

# Claude Code local session metadata (scheduled tasks, local settings)
# 預設整個 .claude/ 不 commit；.claude/skills/ 例外（共享 skill 視為專案資產）
.claude/*
!.claude/skills/

# Playwright MCP local cache
.playwright-mcp/

# Playwright headless CLI artifacts（pw-login.mjs 產出的 storageState + ad-hoc 截圖）
/scripts/.pw-state.json
/scripts/pw-*.png

# Local spec/reference docs (not part of the app)
*.docx
*.xlsx
*.xls
*.txt

# Claude Code instructions — CLAUDE.md 改成共享（架構規矩 / design pattern 視為專案資產）
# AGENTS.md 維持本機（可能含環境特定 context）
AGENTS.md

# Notification Hub — Phase 0 webhook 側錄（含 userId / groupId，不要 commit）
.line-webhook.log

# Playwright e2e — auth storageState + report
/tests/e2e/.auth/
/playwright-report/
/test-results/
.claude/handoffs/*.md

# 開發過程的截圖（驗證 / debug artifact）—— 別 commit 到 repo root
/*.png

# Chrome MCP 端對端測試截圖（驗證 artifact）
/.claude-test-screenshots/

# ERD 抽 schema 用的 scratch（Python script + 中介 JSON）
/tmp_erd/

# Smoke / debug 截圖工件（pw-smoke-*.mjs 會寫到 tmp/，數十 MB、別 commit）
/tmp/

# /spike dev artifacts (HTTPS self-signed cert，含 private key)
/.spike/
